diff --git a/app/src/main/java/com/gaurav/avnc/ui/vnc/input/KeyHandler.kt b/app/src/main/java/com/gaurav/avnc/ui/vnc/input/KeyHandler.kt
index 08e3f40..cc509e4 100644
--- a/app/src/main/java/com/gaurav/avnc/ui/vnc/input/KeyHandler.kt
+++ b/app/src/main/java/com/gaurav/avnc/ui/vnc/input/KeyHandler.kt
@@ -108,6 +108,16 @@ class KeyHandler(private val dispatcher: Dispatcher, prefs: AppPreferences) {
         return onKeyEvent(event)
     }
 
+    /**
+     * Sends a whole string as Unicode keysyms.
+     * Used by the local voice buffer. The remote field must already be focused.
+     */
+    fun sendText(text: String): Boolean {
+        if (text.isEmpty()) return false
+        val event = KeyEvent(android.os.SystemClock.uptimeMillis(), text, KeyCharacterMap.VIRTUAL_KEYBOARD, 0)
+        return onKeyEvent(event)
+    }
+
     /************************************************************************************
      * Event Handling
      ***********************************************************************************/
